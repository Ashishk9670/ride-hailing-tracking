{
  "uid": "ride-hailing",
  "title": "Ride Hailing Tracking",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Location updates / sec", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (stage) (rate(driver_location_updates_total[1m]))", "legendFormat": "{{stage}}" } ] },
    { "id": 2, "type": "timeseries", "title": "Ride matches / sec", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (result) (rate(rides_matches_total[1m]))", "legendFormat": "{{result}}" } ] },
    { "id": 3, "type": "timeseries", "title": "Match latency (p50 / p95 / p99)", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(rides_match_latency_seconds_bucket[1m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(rides_match_latency_seconds_bucket[1m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(rides_match_latency_seconds_bucket[1m])))", "legendFormat": "p99" } ] },
    { "id": 4, "type": "timeseries", "title": "Dead-lettered locations / expired drivers", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(location_dlt_total[5m]))", "legendFormat": "DLT (5m)" },
        { "refId": "B", "expr": "sum(increase(drivers_expired_total[5m]))", "legendFormat": "expired (5m)" } ] },
    { "id": 5, "type": "timeseries", "title": "HTTP request rate by status", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{status}}" } ] },
    { "id": 6, "type": "timeseries", "title": "JVM heap used", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap" } ] }
  ]
}
